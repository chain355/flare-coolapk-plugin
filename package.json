{
  "name": "flare-plugin-coolapk",
  "version": "0.1.9",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Coolapk (酷安) social plugin for Flare: anonymous read-only timeline + local following list",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
