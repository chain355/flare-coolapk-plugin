    "package:v2": "npm run check && node build.mjs --package-v2",
    "test": "node tools/harness.mjs"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "flare-plugin-sdk": "0.1.0-beta.11",
    "typescript": "6.0.3"
  }
}
